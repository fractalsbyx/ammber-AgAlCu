
subsection Rectangular mesh
  set x lower bound = 0
  set y lower bound = 0
  set z lower bound = 0
  set x size = 2e-6
  set y size = 2e-6
  set z size = 2e-6
end

set global refinement = 9
set max refinement    = 9
set min refinement    = 4
set mesh adaptivity   = true
set remeshing period  = 500

set time step = 1.0
set num_steps = 10000000

subsection output
  set condition = EQUAL_SPACING
  set number    = 500
  set list = 1
end

# =================================================================================
# Set the model constants
# =================================================================================

# Lamellar eutectic seed along the bottom of the domain (see custom_pde.h)
# Height of the seed (m)
set Model constant seed_height = 0.2e-6, DOUBLE
# Number of ABAC periods (Al2Cu | alpha-Al | Ag2Al | alpha-Al) across x

set Model constant scale_with_domain = false, BOOL
set Model constant num_periods = 2, INT
set Model constant period = 1e-6, DOUBLE

# =================================================================================
# Set the automatic parameter selection constants
# =================================================================================

# Design factor for timestep.
# A value in (0, 1), practically in [0.1, 0.5]
# lower value -> more stable
set Model constant stability_factor = 0.2, DOUBLE

# Number of points in interface when automatically selecting length scale
# n > 4 reccommended
set Model constant num_points_in_interface = 6.0, DOUBLE
